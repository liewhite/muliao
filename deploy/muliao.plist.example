<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd 用户服务。把 /Users/YOU 换成实际 home。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.muliao</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/muliao</string>
    <string>--config</string>
    <string>/Users/YOU/.muliao/config.toml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/.muliao</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- agent 的 shell 与 stdio MCP（如 npx）从这里找命令 -->
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 关停（SIGTERM）后等进程自己退出的秒数，超时才 SIGKILL。不设时 kickstart -k 约 5 秒就强杀，
       来不及结束后台任务的进程组并通知 agent；要大于 HTTP 连接排空（3 秒）加 lifespan 关停（最多约 20 秒）。 -->
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.muliao/muliao.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.muliao/muliao.log</string>
</dict>
</plist>
