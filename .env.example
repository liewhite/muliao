# 登录密码（至少 8 位）
MULIAO_PASSWORD=
# cookie 签名密钥（至少 32 位）：python -c "import secrets; print(secrets.token_hex(32))"
MULIAO_SECRET_KEY=
# vault 加密密钥：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 丢失后 vault 中的 secret 无法解密
MULIAO_VAULT_KEY=

# 对外访问地址（iOS 推送要求 HTTPS）
MULIAO_PUBLIC_URL=https://assistant.example.com
# Web Push 的联系方式，mailto: 或 https:
MULIAO_VAPID_SUBJECT=mailto:you@example.com
MULIAO_HOST=127.0.0.1
MULIAO_PORT=8000
MULIAO_DATA_DIR=data
MULIAO_TIMEZONE=Asia/Shanghai

# 新建 agent 时的默认模型（pydantic-ai 模型字符串）
MULIAO_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# 各模型提供方的 key 按 pydantic-ai 的约定读取
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# 可选：Telegram 入口
# MULIAO_TELEGRAM_BOT_TOKEN=
# MULIAO_TELEGRAM_AGENT=assistant
# MULIAO_TELEGRAM_ALLOWED_CHAT_IDS=[123456789]
